{
  "cases": [
    {
      "name": "rg single file",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs/a.txt"},
      "files": {"/docs/a.txt": "foo one\nbar\nfoo two\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/docs/a.txt", "matches": [{"line": 1, "text": "foo one"}, {"line": 3, "text": "foo two"}]}]},
        "attrs": {"action": "rg", "path": "/docs/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg recursive directory byte order",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs"},
      "files": {"/docs/b.txt": "foo b\n", "/docs/a.txt": "foo a\n", "/docs/sub/c.txt": "foo c\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/docs/a.txt", "matches": [{"line": 1, "text": "foo a"}]}, {"path": "/docs/b.txt", "matches": [{"line": 1, "text": "foo b"}]}, {"path": "/docs/sub/c.txt", "matches": [{"line": 1, "text": "foo c"}]}]},
        "attrs": {"action": "rg", "path": "/docs", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg default path is workdir",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo"},
      "workdir": "/d",
      "files": {"/d/a.txt": "foo a\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/d/a.txt", "matches": [{"line": 1, "text": "foo a"}]}]},
        "attrs": {"action": "rg", "path": "/d", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg smart case insensitive (lowercase pattern)",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "todo", "path": "/a.txt"},
      "files": {"/a.txt": "TODO: fix\nnothing\nTodo: ship\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "TODO: fix"}, {"line": 3, "text": "Todo: ship"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg smart case sensitive (uppercase in pattern)",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "Todo", "path": "/a.txt"},
      "files": {"/a.txt": "TODO: fix\nnothing\nTodo: ship\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 3, "text": "Todo: ship"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg regex alternation and anchor",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^(foo|baz)\\d+", "path": "/a.txt"},
      "files": {"/a.txt": "foo123 ok\nbar baz9\nbaz42\nxfoo1\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "foo123 ok"}, {"line": 3, "text": "baz42"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg CRLF strip",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\r\nbar\r\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg skips binary files",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs"},
      "files": {"/docs/bin.dat": "base64:AMBmb28=", "/docs/a.txt": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/docs/a.txt", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/docs", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg skips hidden files and dirs by default",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/p"},
      "files": {"/p/a.txt": "foo\n", "/p/.secret": "foo secret\n", "/p/node_modules/pkg/index.js": "foo\n", "/p/vendor/lib/v.go": "foo\n", "/p/.git/config": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/p/a.txt", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/p", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg all includes dotfiles and dot dirs",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/p", "all": true},
      "files": {"/p/a.txt": "foo\n", "/p/.secret": "foo secret\n", "/p/.git/config": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/p/.git/config", "matches": [{"line": 1, "text": "foo"}]}, {"path": "/p/.secret", "matches": [{"line": 1, "text": "foo secret"}]}, {"path": "/p/a.txt", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/p", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg glob filter search",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "todo", "path": "/src", "glob": ["*.go"]},
      "files": {"/src/a.go": "todo a\n", "/src/b.md": "todo b\n", "/src/sub/c.go": "todo c\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/src/a.go", "matches": [{"line": 1, "text": "todo a"}]}, {"path": "/src/sub/c.go", "matches": [{"line": 1, "text": "todo c"}]}]},
        "attrs": {"action": "rg", "path": "/src", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg lookaround rejected with escape hatch",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo(?=bar)", "path": "/a.txt"},
      "files": {"/a.txt": "foobar\n"},
      "expectError": "fs rg: pattern is not supported on this environment (restricted: no lookaround/backreference), use bash -c \"grep -P ...\" on a physical host"
    },
    {
      "name": "rg backreference rejected",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "(a)\\1", "path": "/a.txt"},
      "files": {"/a.txt": "aa\n"},
      "expectError": "fs rg: pattern is not supported on this environment (restricted: no lookaround/backreference), use bash -c \"grep -P ...\" on a physical host"
    },
    {
      "name": "rg invalid regex",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "[", "path": "/a.txt"},
      "files": {"/a.txt": "x\n"},
      "expectError": "fs rg: invalid pattern: error parsing regexp: missing closing ]: `[`"
    },
    {
      "name": "rg no pattern lists files (single file)",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/a.txt"},
      "files": {"/a.txt": "x\n"},
      "expect": {
        "contentJson": {"files": ["/a.txt"]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg unknown field ignored",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "-n": true, "context": 0},
      "files": {"/a.txt": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg no matches",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "zzz", "path": "/a.txt"},
      "files": {"/a.txt": "foo\n"},
      "expect": {
        "contentJson": {"files": []},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg empty pattern no trailing phantom line",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\nbar\n"},
      "expect": {
        "contentJson": {"files": []},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg empty pattern matches real blank line",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\n\nbar\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 2, "text": ""}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg files byte order",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d"},
      "files": {"/d/c.txt": "c", "/d/a.txt": "a", "/d/sub/b.txt": "b"},
      "expect": {
        "contentJson": {"files": ["/d/a.txt", "/d/c.txt", "/d/sub/b.txt"]},
        "attrs": {"action": "rg", "path": "/d", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg files glob filter",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d", "glob": ["*.go"]},
      "files": {"/d/a.go": "a", "/d/b.txt": "b", "/d/sub/c.go": "c"},
      "expect": {
        "contentJson": {"files": ["/d/a.go", "/d/sub/c.go"]},
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg files defaults to workdir",
      "cmd": "fs",
      "params": {"action": "rg"},
      "workdir": "/d",
      "files": {"/d/x.txt": "x", "/d/y.txt": "y"},
      "expect": {
        "contentJson": {"files": ["/d/x.txt", "/d/y.txt"]},
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg files glob no match",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d", "glob": ["*.rs"]},
      "files": {"/d/a.txt": "a"},
      "expect": {
        "contentJson": {"files": []},
        "attrs": {"action": "rg", "path": "/d", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg word boundary via \\b in pattern",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "\\bfoo\\b", "path": "/a.txt"},
      "files": {"/a.txt": "foo bar\nfoobar\na foo.\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "foo bar"}, {"line": 3, "text": "a foo."}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg glob exclusion",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "glob": ["!*.go"]},
      "files": {"/docs/a.txt": "foo\n", "/docs/b.go": "foo\n", "/docs/c": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/docs/a.txt", "matches": [{"line": 1, "text": "foo"}]}, {"path": "/docs/c", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/docs", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg glob include with exclusion",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/src", "glob": ["*.go", "!*_test.go"]},
      "files": {"/src/a.go": "foo\n", "/src/b_test.go": "foo\n", "/src/c.js": "foo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/src/a.go", "matches": [{"line": 1, "text": "foo"}]}]},
        "attrs": {"action": "rg", "path": "/src", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg context basic with group separator",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "context": 1},
      "files": {"/a.txt": "one\ntwo\nfoo\nbar\nbaz\nqux\nfoo2\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 2, "text": "two", "ctx": true}, {"line": 3, "text": "foo"}, {"line": 4, "text": "bar", "ctx": true}, {"line": 6, "text": "qux", "ctx": true}, {"line": 7, "text": "foo2"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "5", "truncated": "false"}
      }
    },
    {
      "name": "rg context merges adjacent windows",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "context": 1},
      "files": {"/a.txt": "a\nfoo\nb\nfoo\nc\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "a", "ctx": true}, {"line": 2, "text": "foo"}, {"line": 3, "text": "b", "ctx": true}, {"line": 4, "text": "foo"}, {"line": 5, "text": "c", "ctx": true}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "5", "truncated": "false"}
      }
    },
    {
      "name": "rg limit overrides default",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "m", "path": "/a.txt", "limit": 2},
      "files": {"/a.txt": "m1\nm2\nm3\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 1, "text": "m1"}, {"line": 2, "text": "m2"}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "true"}
      }
    },
    {
      "name": "rg limit counts context rows and truncates",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "context": 1, "limit": 3},
      "files": {"/a.txt": "x1\nx2\nfoo\ny1\nfoo\n"},
      "expect": {
        "contentJson": {"files": [{"path": "/a.txt", "matches": [{"line": 2, "text": "x2", "ctx": true}, {"line": 3, "text": "foo"}, {"line": 4, "text": "y1", "ctx": true}]}]},
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "3", "truncated": "true"}
      }
    },
    {
      "name": "rg files limit override",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d", "limit": 2},
      "files": {"/d/a.txt": "a", "/d/b.txt": "b", "/d/c.txt": "c"},
      "expect": {
        "contentJson": {"files": ["/d/a.txt", "/d/b.txt"]},
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "true"}
      }
    },
    {
      "name": "rg exclusion-only glob in files listing",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d", "glob": ["!*.go"]},
      "files": {"/d/a.go": "x", "/d/b.txt": "x", "/d/.h": "x"},
      "expect": {
        "contentJson": {"files": ["/d/b.txt"]},
        "attrs": {"action": "rg", "path": "/d", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg context without pattern rejected",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/d", "context": 2},
      "files": {"/d/a.txt": "x"},
      "expectError": "fs rg: context is only valid for content search (pattern is required)"
    },
    {
      "name": "rg limit out of range",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "x", "path": "/a.txt", "limit": 500},
      "files": {"/a.txt": "x\n"},
      "expectError": "fs rg: limit must be between 1 and 200, got 500"
    },
    {
      "name": "rg context out of range",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "x", "path": "/a.txt", "context": 11},
      "files": {"/a.txt": "x\n"},
      "expectError": "fs rg: context must be between 0 and 10, got 11"
    },
    {
      "name": "rg glob doublestar restricted",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "glob": ["!**/*.go"]},
      "files": {"/docs/a.txt": "foo\n"},
      "expectError": "fs rg: glob \"!**/*.go\" is not supported on this environment (restricted: no '**')"
    }
  ]
}
