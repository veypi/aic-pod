{
  "cases": [
    {
      "name": "rg single file",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs/a.txt"},
      "files": {"/docs/a.txt": "foo one\nbar\nfoo two\n"},
      "expect": {
        "content": "/docs/a.txt:1:foo one\n/docs/a.txt:3:foo two",
        "attrs": {"action": "rg", "path": "/docs/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg recursive directory byte order",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs"},
      "files": {"/docs/b.txt": "foo b\n", "/docs/a.txt": "foo a\n", "/docs/sub/c.txt": "foo c\n"},
      "expect": {
        "content": "/docs/a.txt:1:foo a\n/docs/b.txt:1:foo b\n/docs/sub/c.txt:1:foo c",
        "attrs": {"action": "rg", "path": "/docs", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg default path is workdir",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo"},
      "workdir": "/d",
      "files": {"/d/a.txt": "foo a\n"},
      "expect": {
        "content": "/d/a.txt:1:foo a",
        "attrs": {"action": "rg", "path": "/d", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg insensitive",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "todo", "path": "/a.txt", "insensitive": true},
      "files": {"/a.txt": "TODO: fix\nnothing\nTodo: ship\n"},
      "expect": {
        "content": "/a.txt:1:TODO: fix\n/a.txt:3:Todo: ship",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg regex alternation and anchor",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^(foo|baz)\\d+", "path": "/a.txt"},
      "files": {"/a.txt": "foo123 ok\nbar baz9\nbaz42\nxfoo1\n"},
      "expect": {
        "content": "/a.txt:1:foo123 ok\n/a.txt:3:baz42",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg max_per_file not global truncation",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "max_per_file": 1},
      "files": {"/a.txt": "foo 1\nfoo 2\nfoo 3\n"},
      "expect": {
        "content": "/a.txt:1:foo 1",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg max_per_file applies per file",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/d", "max_per_file": 1},
      "files": {"/d/a.txt": "foo\nfoo\n", "/d/b.txt": "foo\nfoo\n"},
      "expect": {
        "content": "/d/a.txt:1:foo\n/d/b.txt:1:foo",
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg files_only",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "files_only": true},
      "files": {"/docs/a.txt": "foo\nbar\n", "/docs/b.txt": "nothing\n", "/docs/sub/c.txt": "foo\n"},
      "expect": {
        "content": "/docs/a.txt\n/docs/sub/c.txt",
        "attrs": {"action": "rg", "path": "/docs", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg CRLF strip",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\r\nbar\r\n"},
      "expect": {
        "content": "/a.txt:1:foo",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg skips binary files",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs"},
      "files": {"/docs/bin.dat": "base64:AMBmb28=", "/docs/a.txt": "foo\n"},
      "expect": {
        "content": "/docs/a.txt:1:foo",
        "attrs": {"action": "rg", "path": "/docs", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg skips hidden files and dirs by default",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/p"},
      "files": {"/p/a.txt": "foo\n", "/p/.env": "foo secret\n", "/p/node_modules/pkg/index.js": "foo\n", "/p/vendor/lib/v.go": "foo\n", "/p/.git/config": "foo\n"},
      "expect": {
        "content": "/p/a.txt:1:foo",
        "attrs": {"action": "rg", "path": "/p", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg hidden includes dotfiles and dot dirs",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/p", "hidden": true},
      "files": {"/p/a.txt": "foo\n", "/p/.env": "foo secret\n", "/p/.git/config": "foo\n"},
      "expect": {
        "content": "/p/.env:1:foo secret\n/p/.git/config:1:foo\n/p/a.txt:1:foo",
        "attrs": {"action": "rg", "path": "/p", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg glob filter search",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "todo", "path": "/src", "glob": ["*.go"]},
      "files": {"/src/a.go": "todo a\n", "/src/b.md": "todo b\n", "/src/sub/c.go": "todo c\n"},
      "expect": {
        "content": "/src/a.go:1:todo a\n/src/sub/c.go:1:todo c",
        "attrs": {"action": "rg", "path": "/src", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg lookaround rejected with escape hatch",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo(?=bar)", "path": "/a.txt"},
      "files": {"/a.txt": "foobar\n"},
      "expectError": "fs rg: pattern is not supported on this environment (restricted: no lookaround/backreference), use bash -c \"grep -P ...\" on a physical host"
    },
    {
      "name": "rg backreference rejected",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "(a)\\1", "path": "/a.txt"},
      "files": {"/a.txt": "aa\n"},
      "expectError": "fs rg: pattern is not supported on this environment (restricted: no lookaround/backreference), use bash -c \"grep -P ...\" on a physical host"
    },
    {
      "name": "rg invalid regex",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "[", "path": "/a.txt"},
      "files": {"/a.txt": "x\n"},
      "expectError": "fs rg: invalid pattern: error parsing regexp: missing closing ]: `[`"
    },
    {
      "name": "rg missing pattern",
      "cmd": "fs",
      "params": {"action": "rg", "path": "/a.txt"},
      "files": {"/a.txt": "x\n"},
      "expectError": "fs rg: pattern is required (or set files=true to list files)"
    },
    {
      "name": "rg unknown field rejected",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "-n": true},
      "files": {"/a.txt": "foo\n"},
      "expectError": "fs: invalid params: json: unknown field \"-n\""
    },
    {
      "name": "rg no matches",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "zzz", "path": "/a.txt"},
      "files": {"/a.txt": "foo\n"},
      "expect": {
        "content": "no matches for pattern \"zzz\" in /a.txt",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg empty pattern no trailing phantom line",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\nbar\n"},
      "expect": {
        "content": "no matches for pattern \"^$\" in /a.txt",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg empty pattern matches real blank line",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "^$", "path": "/a.txt"},
      "files": {"/a.txt": "foo\n\nbar\n"},
      "expect": {
        "content": "/a.txt:2:",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg files byte order",
      "cmd": "fs",
      "params": {"action": "rg", "files": true, "path": "/d"},
      "files": {"/d/c.txt": "c", "/d/a.txt": "a", "/d/sub/b.txt": "b"},
      "expect": {
        "content": "/d/a.txt\n/d/c.txt\n/d/sub/b.txt",
        "attrs": {"action": "rg", "path": "/d", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "rg files glob filter",
      "cmd": "fs",
      "params": {"action": "rg", "files": true, "path": "/d", "glob": ["*.go"]},
      "files": {"/d/a.go": "a", "/d/b.txt": "b", "/d/sub/c.go": "c"},
      "expect": {
        "content": "/d/a.go\n/d/sub/c.go",
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg files defaults to workdir",
      "cmd": "fs",
      "params": {"action": "rg", "files": true},
      "workdir": "/d",
      "files": {"/d/x.txt": "x", "/d/y.txt": "y"},
      "expect": {
        "content": "/d/x.txt\n/d/y.txt",
        "attrs": {"action": "rg", "path": "/d", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg files single file",
      "cmd": "fs",
      "params": {"action": "rg", "files": true, "path": "/a.txt"},
      "files": {"/a.txt": "hello"},
      "expect": {
        "content": "/a.txt",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg files glob no match",
      "cmd": "fs",
      "params": {"action": "rg", "files": true, "path": "/d", "glob": ["*.rs"]},
      "files": {"/d/a.txt": "a"},
      "expect": {
        "content": "no files matched globs *.rs in /d",
        "attrs": {"action": "rg", "path": "/d", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "rg files rejects search params",
      "cmd": "fs",
      "params": {"action": "rg", "files": true, "path": "/d", "insensitive": true},
      "files": {"/d/a.txt": "a"},
      "expectError": "fs rg: files mode cannot be combined with search params (pattern, insensitive, files_only, count, word, max_per_file)"
    },
    {
      "name": "rg count per file",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "count": true},
      "files": {"/docs/a.txt": "foo one\nbar\nfoo two\n", "/docs/b.txt": "nothing\n", "/docs/c.txt": "foo\n"},
      "expect": {
        "content": "/docs/a.txt:2\n/docs/c.txt:1",
        "attrs": {"action": "rg", "path": "/docs", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg count with max_per_file still counts all",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "count": true, "max_per_file": 1},
      "files": {"/a.txt": "foo one\nfoo two\nfoo three\n"},
      "expect": {
        "content": "/a.txt:3",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "rg word boundary",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/a.txt", "word": true},
      "files": {"/a.txt": "foo bar\nfoobar\na foo.\n"},
      "expect": {
        "content": "/a.txt:1:foo bar\n/a.txt:3:a foo.",
        "attrs": {"action": "rg", "path": "/a.txt", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "rg glob negation restricted",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "glob": ["!*.go"]},
      "files": {"/docs/a.txt": "foo\n"},
      "expectError": "fs rg: glob \"!*.go\" is not supported on this environment (restricted: no '!' negation or '**')"
    },
    {
      "name": "rg glob doublestar restricted",
      "cmd": "fs",
      "params": {"action": "rg", "pattern": "foo", "path": "/docs", "glob": ["**/*.go"]},
      "files": {"/docs/a.txt": "foo\n"},
      "expectError": "fs rg: glob \"**/*.go\" is not supported on this environment (restricted: no '!' negation or '**')"
    }
  ]
}
