{
  "cases": [
    {
      "name": "rm file",
      "cmd": "fs",
      "params": {"action": "rm", "path": "/tmp.txt"},
      "files": {"/tmp.txt": "x"},
      "expect": {
        "content": "removed /tmp.txt",
        "attrs": {"action": "rm", "path": "/tmp.txt"}
      },
      "expectFiles": {}
    },
    {
      "name": "rm empty dir",
      "cmd": "fs",
      "params": {"action": "rm", "path": "/d"},
      "files": {"/d/": ""},
      "expect": {
        "content": "removed /d",
        "attrs": {"action": "rm", "path": "/d"}
      },
      "expectFiles": {}
    },
    {
      "name": "rm non-empty dir without recursive",
      "cmd": "fs",
      "params": {"action": "rm", "path": "/d"},
      "files": {"/d/a.txt": "a"},
      "expectError": "fs rm: /d is a non-empty directory (set recursive=true)"
    },
    {
      "name": "rm recursive counts items",
      "cmd": "fs",
      "params": {"action": "rm", "path": "/d", "recursive": true},
      "files": {"/d/a.txt": "a", "/d/sub/b.txt": "b"},
      "expect": {
        "content": "removed /d (3 items)",
        "attrs": {"action": "rm", "path": "/d", "items": "3"}
      },
      "expectFiles": {}
    },
    {
      "name": "rm root protection",
      "cmd": "fs",
      "params": {"action": "rm", "path": "/users/u1", "recursive": true},
      "protectRoots": ["/users/u1"],
      "files": {"/users/u1/a.txt": "a"},
      "expectError": "rm: cannot remove root directory /users/u1"
    },
    {
      "name": "rm drive root protection (backslash input normalized)",
      "cmd": "fs",
      "params": {"action": "rm", "path": "C:\\", "recursive": true},
      "protectRoots": ["C:"],
      "files": {},
      "expectError": "rm: cannot remove root directory C:"
    },
    {
      "name": "rm drive root protection (slash input)",
      "cmd": "fs",
      "params": {"action": "rm", "path": "C:/"},
      "protectRoots": ["C:"],
      "files": {},
      "expectError": "rm: cannot remove root directory C:"
    },
    {
      "name": "cp file",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/a.txt", "dst": "/b.txt"},
      "files": {"/a.txt": "content"},
      "expect": {
        "content": "copied /a.txt to /b.txt",
        "attrs": {"action": "cp", "path": "/b.txt", "source_path": "/a.txt"}
      },
      "expectFiles": {"/a.txt": "content", "/b.txt": "content"}
    },
    {
      "name": "cp destination exists",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/a.txt", "dst": "/b.txt"},
      "files": {"/a.txt": "x", "/b.txt": "y"},
      "expectError": "fs cp: destination /b.txt already exists"
    },
    {
      "name": "cp dir without recursive",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/d", "dst": "/e"},
      "files": {"/d/a.txt": "a"},
      "expectError": "fs cp: /d is a directory (set recursive=true)"
    },
    {
      "name": "cp recursive dir",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/d", "dst": "/e", "recursive": true},
      "files": {"/d/a.txt": "a", "/d/sub/b.txt": "b"},
      "expect": {
        "content": "copied /d to /e",
        "attrs": {"action": "cp", "path": "/e", "source_path": "/d"}
      },
      "expectFiles": {"/d/": "", "/d/a.txt": "a", "/d/sub/": "", "/d/sub/b.txt": "b", "/e/": "", "/e/a.txt": "a", "/e/sub/": "", "/e/sub/b.txt": "b"}
    },
    {
      "name": "cp into itself",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/d", "dst": "/d/sub", "recursive": true},
      "files": {"/d/a.txt": "a"},
      "expectError": "fs cp: cannot copy directory /d into itself: /d/sub"
    },
    {
      "name": "cp auto-creates dst parent",
      "cmd": "fs",
      "params": {"action": "cp", "src": "/a.txt", "dst": "/new/dir/b.txt"},
      "files": {"/a.txt": "content"},
      "expect": {
        "content": "copied /a.txt to /new/dir/b.txt",
        "attrs": {"action": "cp", "path": "/new/dir/b.txt", "source_path": "/a.txt"}
      },
      "expectFiles": {"/a.txt": "content", "/new/": "", "/new/dir/": "", "/new/dir/b.txt": "content"}
    },
    {
      "name": "mv file",
      "cmd": "fs",
      "params": {"action": "mv", "src": "/old.txt", "dst": "/new.txt"},
      "files": {"/old.txt": "content"},
      "expect": {
        "content": "moved /old.txt to /new.txt",
        "attrs": {"action": "mv", "path": "/new.txt", "source_path": "/old.txt"}
      },
      "expectFiles": {"/new.txt": "content"}
    },
    {
      "name": "mv identical",
      "cmd": "fs",
      "params": {"action": "mv", "src": "/a.txt", "dst": "/a.txt"},
      "files": {"/a.txt": "x"},
      "expectError": "fs mv: /a.txt and /a.txt are identical"
    },
    {
      "name": "mv destination exists",
      "cmd": "fs",
      "params": {"action": "mv", "src": "/a.txt", "dst": "/b.txt"},
      "files": {"/a.txt": "x", "/b.txt": "y"},
      "expectError": "fs mv: destination /b.txt already exists"
    },
    {
      "name": "mv root protection",
      "cmd": "fs",
      "params": {"action": "mv", "src": "/users/u1", "dst": "/elsewhere"},
      "protectRoots": ["/users/u1"],
      "files": {"/users/u1/a.txt": "a"},
      "expectError": "mv: cannot move root directory /users/u1"
    }
  ]
}
