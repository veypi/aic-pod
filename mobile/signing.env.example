# 移动端签名材料环境变量样例（真值在 signing/PASSWORDS.md，不入库）
# 复制为 signing/signing.env 后填入真值；该文件在 .gitignore 内。

# Android（PKCS#12 keystore）
AIC_ANDROID_KEYSTORE=signing/android/ivec-release.p12
AIC_ANDROID_KEY_ALIAS=ivec-release
AIC_ANDROID_KEYSTORE_PASSWORD=

# iOS
AIC_IOS_P12=signing/ios/apple-distribution.p12
AIC_IOS_CERT=signing/ios/AppleDistribution.cer
AIC_IOS_PROFILE=
AIC_IOS_P12_PASSWORD=

# HarmonyOS（待 AGC 建 APP ID 后补齐）
AIC_HARMONY_P12=signing/harmonyos/app-release.p12
AIC_HARMONY_CERT=signing/harmonyos/app-release.cer
AIC_HARMONY_PROFILE=signing/harmonyos/app-release.p7b
AIC_HARMONY_P12_PASSWORD=

# 三端统一包名
AIC_APP_ID=com.ivec.ai
AIC_APP_NAME=ivec AI
