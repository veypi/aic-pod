{
  "name": "aic-desktop",
  "productName": "AIC Desktop",
  "version": "0.5.6",
  "description": "AIC Desktop — Electron shell + Go backend (host agent)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cua-sync": "node scripts/sync-cua.mjs",
    "predist": "node scripts/sync-cua.mjs",
    "dist": "electron-builder",
    "predist:mac": "node scripts/sync-cua.mjs",
    "dist:mac": "electron-builder --mac",
    "predist:win": "node scripts/sync-cua.mjs",
    "dist:win": "electron-builder --win",
    "predist:linux": "node scripts/sync-cua.mjs",
    "dist:linux": "electron-builder --linux",
    "test": "node --test ui/*.test.mjs browser/*.test.mjs",
    "test:browser:live": "electron scripts/test-browser-live.mjs"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
