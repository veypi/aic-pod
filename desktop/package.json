{
  "name": "aic-desktop",
  "productName": "AIC Desktop",
  "version": "0.5.6",
  "description": "AIC Desktop — Electron shell + Go backend (host agent)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/sync-browser.mjs",
    "start": "electron .",
    "cua-sync": "node scripts/sync-cua.mjs",
    "predist": "node scripts/sync-browser.mjs && node scripts/sync-cua.mjs",
    "dist": "electron-builder",
    "predist:mac": "node scripts/sync-browser.mjs && node scripts/sync-cua.mjs",
    "dist:mac": "electron-builder --mac",
    "predist:win": "node scripts/sync-browser.mjs && node scripts/sync-cua.mjs",
    "dist:win": "electron-builder --win",
    "predist:linux": "node scripts/sync-browser.mjs && node scripts/sync-cua.mjs",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
