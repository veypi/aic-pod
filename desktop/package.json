{
  "name": "aic-desktop",
  "productName": "ivec",
  "version": "0.10.6",
  "description": "ivec — Electron shell + Go backend (host agent)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cua-sync": "node scripts/sync-cua.mjs",
    "browser-sync": "node scripts/sync-browser.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node --test *.test.cjs scripts/*.test.mjs",
    "runtime-sync": "npm run browser-sync && npm run cua-sync && npm run agent-browser-sync",
    "agent-browser-sync": "node scripts/sync-agent-browser.mjs"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
