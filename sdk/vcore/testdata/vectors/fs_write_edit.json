{
  "cases": [
    {
      "name": "write new file",
      "cmd": "fs",
      "params": {"action": "write", "path": "/notes.txt", "content": "第一行\n第二行\n"},
      "files": {},
      "expect": {
        "content": "wrote file: /notes.txt (2 lines, 20 bytes)",
        "attrs": {"action": "write", "path": "/notes.txt", "mode": "overwrite", "lines": "2", "bytes": "20"}
      },
      "expectFiles": {"/notes.txt": "第一行\n第二行\n"}
    },
    {
      "name": "write creates parent dirs",
      "cmd": "fs",
      "params": {"action": "write", "path": "/a/b/c.txt", "content": "x"},
      "files": {},
      "expect": {
        "content": "wrote file: /a/b/c.txt (1 lines, 1 bytes)",
        "attrs": {"action": "write", "path": "/a/b/c.txt", "mode": "overwrite", "lines": "1", "bytes": "1"}
      },
      "expectFiles": {"/a/": "", "/a/b/": "", "/a/b/c.txt": "x"}
    },
    {
      "name": "write empty content",
      "cmd": "fs",
      "params": {"action": "write", "path": "/empty.txt", "content": ""},
      "files": {},
      "expect": {
        "content": "wrote file: /empty.txt (0 lines, 0 bytes)",
        "attrs": {"action": "write", "path": "/empty.txt", "mode": "overwrite", "lines": "0", "bytes": "0"}
      },
      "expectFiles": {"/empty.txt": ""}
    },
    {
      "name": "write content required",
      "cmd": "fs",
      "params": {"action": "write", "path": "/x.txt"},
      "files": {},
      "expectError": "fs write: content is required"
    },
    {
      "name": "write with workdir",
      "cmd": "fs",
      "params": {"action": "write", "path": "notes.txt", "content": "hello", "workdir": "/wd"},
      "files": {"/wd/": ""},
      "expect": {
        "content": "wrote file: /wd/notes.txt (1 lines, 5 bytes)",
        "attrs": {"action": "write", "path": "/wd/notes.txt", "mode": "overwrite", "lines": "1", "bytes": "5"}
      },
      "expectFiles": {"/wd/": "", "/wd/notes.txt": "hello"}
    },
    {
      "name": "edit single replacement",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "旧内容A", "newText": "新内容A"}]},
      "files": {"/foo.txt": "前缀旧内容A后缀\n"},
      "expect": {
        "content": "updated file: /foo.txt (1 edits)",
        "attrs": {"action": "edit", "path": "/foo.txt", "edits": "1"}
      },
      "expectFiles": {"/foo.txt": "前缀新内容A后缀\n"}
    },
    {
      "name": "edit multiple edits",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "aaa", "newText": "bbb"}, {"oldText": "ccc", "newText": ""}]},
      "files": {"/foo.txt": "aaa middle ccc end\n"},
      "expect": {
        "content": "updated file: /foo.txt (2 edits)",
        "attrs": {"action": "edit", "path": "/foo.txt", "edits": "2"}
      },
      "expectFiles": {"/foo.txt": "bbb middle  end\n"}
    },
    {
      "name": "edit oldText not found",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "nope", "newText": "x"}]},
      "files": {"/foo.txt": "hello\n"},
      "expectError": "fs edit: edit[1]: oldText not found in file"
    },
    {
      "name": "edit oldText not unique",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "dup", "newText": "x"}]},
      "files": {"/foo.txt": "dup and dup\n"},
      "expectError": "fs edit: edit[1]: oldText matches 2 locations; provide more surrounding context to make it unique"
    },
    {
      "name": "edit newText equals oldText",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "same", "newText": "same"}]},
      "files": {"/foo.txt": "same\n"},
      "expectError": "fs edit: edit[1]: newText must be different from oldText"
    },
    {
      "name": "edit overlap applies first edit",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "abcdef", "newText": "x"}, {"oldText": "cde", "newText": "y"}]},
      "files": {"/foo.txt": "abcdef\n"},
      "expect": {
        "content": "updated file: /foo.txt (1/2 edits applied; failed: edit[2]: oldText not found in file)",
        "attrs": {"action": "edit", "path": "/foo.txt", "edits": "1", "edits_failed": "1"}
      },
      "expectFiles": {"/foo.txt": "x\n"}
    },
    {
      "name": "edit edits required",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt"},
      "files": {"/foo.txt": "x\n"},
      "expectError": "fs edit: edits is required"
    },
    {
      "name": "edit partial success keeps applied",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "aaa", "newText": "bbb"}, {"oldText": "nope", "newText": "x"}, {"oldText": "ccc", "newText": ""}]},
      "files": {"/foo.txt": "aaa ccc\n"},
      "expect": {
        "content": "updated file: /foo.txt (2/3 edits applied; failed: edit[2]: oldText not found in file)",
        "attrs": {"action": "edit", "path": "/foo.txt", "edits": "2", "edits_failed": "1"}
      },
      "expectFiles": {"/foo.txt": "bbb \n"}
    },
    {
      "name": "edit all fail reports no write",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "nope", "newText": "x"}, {"oldText": "nope2", "newText": "y"}]},
      "files": {"/foo.txt": "hello\n"},
      "expectError": "fs edit: no edits applied: edit[1]: oldText not found in file; edit[2]: oldText not found in file"
    },
    {
      "name": "edit regex backslashes match literally",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/re.txt", "edits": [{"oldText": "/<file_uploaded\\s+path=\"([^\"]*)\"/g", "newText": "/x/g"}]},
      "files": {"/re.txt": "const re = /<file_uploaded\\s+path=\"([^\"]*)\"/g;\n"},
      "expect": {
        "content": "updated file: /re.txt (1 edits)",
        "attrs": {"action": "edit", "path": "/re.txt", "edits": "1"}
      },
      "expectFiles": {"/re.txt": "const re = /x/g;\n"}
    },
    {
      "name": "edit oldText double-encoded unicode escapes gets hint",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/re.txt", "edits": [{"oldText": "const re = /\\u003cfile\\s+path", "newText": "x"}]},
      "files": {"/re.txt": "const re = /<file\\s+path\n"},
      "expectError": "fs edit: edit[1]: oldText not found in file (hint: oldText contains literal \"\\u003c\"-style escapes from double JSON encoding; decoded form matches the file, resend with actual characters)"
    },
    {
      "name": "edit partial failure reports double-encoding hint",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "aaa", "newText": "bbb"}, {"oldText": "tail \\u003c/end\\u003e", "newText": "x"}]},
      "files": {"/foo.txt": "aaa tail </end>\n"},
      "expect": {
        "content": "updated file: /foo.txt (1/2 edits applied; failed: edit[2]: oldText not found in file (hint: oldText contains literal \"\\u003c\"-style escapes from double JSON encoding; decoded form matches the file, resend with actual characters))",
        "attrs": {"action": "edit", "path": "/foo.txt", "edits": "1", "edits_failed": "1"}
      },
      "expectFiles": {"/foo.txt": "bbb tail </end>\n"}
    },
    {
      "name": "edit literal unicode escape without decoded match gets no hint",
      "cmd": "fs",
      "params": {"action": "edit", "path": "/foo.txt", "edits": [{"oldText": "missing \\u003c tag", "newText": "x"}]},
      "files": {"/foo.txt": "hello\n"},
      "expectError": "fs edit: edit[1]: oldText not found in file"
    }
  ]
}
