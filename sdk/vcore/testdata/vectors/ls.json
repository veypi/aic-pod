{
  "cases": [
    {
      "name": "ls directory",
      "cmd": "ls",
      "argv": ["/docs"],
      "files": {"/docs/a.txt": "a", "/docs/b.txt": "b", "/docs/sub/": ""},
      "expect": {
        "content": "a.txt\nb.txt\nsub/",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "ls hides dotfiles by default",
      "cmd": "ls",
      "argv": ["/docs"],
      "files": {"/docs/a.txt": "a", "/docs/.env": "x", "/docs/.git/": ""},
      "expect": {
        "content": "a.txt",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls -a shows dotfiles",
      "cmd": "ls",
      "argv": ["-a", "/docs"],
      "files": {"/docs/a.txt": "a", "/docs/.env": "x", "/docs/.git/": ""},
      "expect": {
        "content": ".env\n.git/\na.txt",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "ls -la combo with size and mtime",
      "cmd": "ls",
      "argv": ["-la", "/docs"],
      "files": {"/docs/b.txt": "bb", "/docs/a.txt": "a", "/docs/.env": "xyz"},
      "mtimes": {"/docs/a.txt": 1700000000, "/docs/b.txt": 1700000001, "/docs/.env": 1700000002},
      "expect": {
        "content": ".env\t3\t1700000002\na.txt\t1\t1700000000\nb.txt\t2\t1700000001",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "ls -l long format",
      "cmd": "ls",
      "argv": ["-l", "/docs"],
      "files": {"/docs/b.txt": "bb", "/docs/a.txt": "a"},
      "mtimes": {"/docs/a.txt": 1700000000, "/docs/b.txt": 1700000001},
      "expect": {
        "content": "a.txt\t1\t1700000000\nb.txt\t2\t1700000001",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "2", "truncated": "false"}
      }
    },
    {
      "name": "ls -l raw size (no -h)",
      "cmd": "ls",
      "argv": ["-l", "/docs"],
      "files": {"/docs/big.bin": "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"},
      "mtimes": {"/docs/big.bin": 1700000000},
      "expect": {
        "content": "big.bin\t100\t1700000000",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls -lh human readable size",
      "cmd": "ls",
      "argv": ["-lh", "/docs"],
      "files": {"/docs/big.bin": "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"},
      "mtimes": {"/docs/big.bin": 1700000000},
      "expect": {
        "content": "big.bin\t100B\t1700000000",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls -lh human readable size k/m units",
      "cmd": "ls",
      "argv": ["-lh", "/docs"],
      "files": {"/docs/k.bin": ""},
      "mtimes": {"/docs/k.bin": 1700000000},
      "expect": {
        "content": "k.bin\t1.0K\t1700000000",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls -h alone has no effect (GNU alignment)",
      "cmd": "ls",
      "argv": ["-h", "/docs"],
      "files": {"/docs/a.txt": "a"},
      "expect": {
        "content": "a.txt",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls -t stable: same mtime sorts by name",
      "cmd": "ls",
      "argv": ["-t", "/docs"],
      "files": {"/docs/b.txt": "b", "/docs/a.txt": "a", "/docs/c.txt": "c"},
      "mtimes": {"/docs/a.txt": 1700000000, "/docs/b.txt": 1700000000, "/docs/c.txt": 1700000000},
      "expect": {
        "content": "a.txt\nb.txt\nc.txt",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "ls -t sorts by mtime desc",
      "cmd": "ls",
      "argv": ["-t", "/docs"],
      "files": {"/docs/old.txt": "o", "/docs/new.txt": "n", "/docs/mid.txt": "m"},
      "mtimes": {"/docs/old.txt": 1700000000, "/docs/new.txt": 1700000002, "/docs/mid.txt": 1700000001},
      "expect": {
        "content": "new.txt\nmid.txt\nold.txt",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "3", "truncated": "false"}
      }
    },
    {
      "name": "ls single file prints name",
      "cmd": "ls",
      "argv": ["/docs/a.txt"],
      "files": {"/docs/a.txt": "a"},
      "expect": {
        "content": "a.txt",
        "attrs": {"action": "ls", "path": "/docs/a.txt", "path_kind": "file", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls empty directory",
      "cmd": "ls",
      "argv": ["/docs"],
      "files": {"/docs/": ""},
      "expect": {
        "content": "empty directory: /docs",
        "attrs": {"action": "ls", "path": "/docs", "path_kind": "directory", "rows": "0", "truncated": "false"}
      }
    },
    {
      "name": "ls default workdir",
      "cmd": "ls",
      "argv": [],
      "workdir": "/wd",
      "files": {"/wd/x.txt": "x"},
      "expect": {
        "content": "x.txt",
        "attrs": {"action": "ls", "path": "/wd", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls relative path via workdir",
      "cmd": "ls",
      "argv": ["sub"],
      "workdir": "/wd",
      "files": {"/wd/sub/y.txt": "y"},
      "expect": {
        "content": "y.txt",
        "attrs": {"action": "ls", "path": "/wd/sub", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls with root var",
      "cmd": "ls",
      "argv": ["$USER/docs"],
      "vars": {"$USER": "/users/u1"},
      "files": {"/users/u1/docs/z.txt": "z"},
      "expect": {
        "content": "z.txt",
        "attrs": {"action": "ls", "path": "/users/u1/docs", "path_kind": "directory", "rows": "1", "truncated": "false"}
      }
    },
    {
      "name": "ls unknown flag restricted feedback",
      "cmd": "ls",
      "argv": ["-x"],
      "files": {},
      "expectError": "ls: flag \"-x\" is not supported on this environment (restricted)"
    },
    {
      "name": "ls extra positional",
      "cmd": "ls",
      "argv": ["/a", "/b"],
      "files": {},
      "expectError": "ls: unexpected argument \"/b\""
    },
    {
      "name": "ls flag equals form restricted feedback",
      "cmd": "ls",
      "argv": ["--la=true"],
      "files": {},
      "expectError": "ls: flag \"--la=true\" is not supported on this environment (restricted; use \"--flag value\" two-element form)"
    }
  ]
}
